<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DustPlanner.Cli</RootNamespace>
    <AssemblyName>dustplanner</AssemblyName>
    <Description>DustPlanner command-line interface.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1303;CA1305;CA1515;CA1812;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DustPlanner.Core/DustPlanner.Core.csproj" />
  </ItemGroup>

</Project>
