<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DustPlanner.Host</RootNamespace>
    <AssemblyName>dustplanner-host</AssemblyName>
    <Description>Local HTTP host: follows Power.log and the exporter inbox and serves a transparent OBS Browser Source overlay (rank, session win rate, dust).</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1303;CA1515;CA1812;CA1848;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DustPlanner.App/DustPlanner.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Overlay/overlay.html" LogicalName="DustPlanner.Host.Overlay.overlay.html" />
    <EmbeddedResource Include="Overlay/index.html" LogicalName="DustPlanner.Host.Overlay.index.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DustPlanner.Host.Tests" />
  </ItemGroup>

</Project>
