<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DustPlanner.Mcp</RootNamespace>
    <AssemblyName>dustplanner-mcp</AssemblyName>
    <Description>Read-only MCP server (stdio) exposing DustPlanner's collection, planner and match history to an AI client.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1303;CA1515;CA1812</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DustPlanner.App/DustPlanner.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DustPlanner.Mcp.Tests" />
  </ItemGroup>

</Project>
