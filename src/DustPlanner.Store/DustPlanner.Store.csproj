<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DustPlanner.Store</RootNamespace>
    <Description>SQLite persistence for DustPlanner: collection snapshots, decks, plans, disenchant history, games and rank samples.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1303;CA2100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DustPlanner.Contracts/DustPlanner.Contracts.csproj" />
    <ProjectReference Include="../DustPlanner.Core/DustPlanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DustPlanner.Store.Tests" />
  </ItemGroup>

</Project>
